<resources>
    <style name="BasePaperTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#2457D6</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">#F3F4F7</item>
        <item name="android:navigationBarColor">#F3F4F7</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">#F3F4F7</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
    </style>
    <style name="PaperTheme" parent="BasePaperTheme" />
</resources>
